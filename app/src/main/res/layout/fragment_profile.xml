<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgRoot">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="14dp"
            android:background="@color/bgCard"
            android:gravity="center"
            android:text="👤"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Dark Mode toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_info"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙  Chế độ tối"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Nút mở Bảng điều khiển Quản trị viên (chỉ hiện khi là Admin) -->
        <TextView
            android:id="@+id/btnAdminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_play"
            android:gravity="center"
            android:padding="12dp"
            android:text="⚙️ Quản trị viên (Admin Panel)"
            android:textColor="#000000"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_info"
            android:gravity="center"
            android:padding="12dp"
            android:text="Đăng xuất"
            android:textColor="@color/textPrimary"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
