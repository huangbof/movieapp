<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="36dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Avatar AI Robot -->
    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chat_ai"
        android:gravity="center"
        android:text="🤖"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAiSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="Nitflex AI"
            android:textColor="@color/colorAccent"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_ai"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvAiMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="AI Response message"
                android:textColor="@color/textPrimary"
                android:textSize="14.5sp" />

            <!-- Danh sách phim đề xuất đính kèm (nếu có) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommendedMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAiTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="3dp"
            android:text="12:00"
            android:textColor="@color/textMuted"
            android:textSize="10.5sp" />

    </LinearLayout>

</LinearLayout>
