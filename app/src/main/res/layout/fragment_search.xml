<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgRoot"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/bgCard"
            android:hint="Tìm kiếm phim..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textMuted" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_play"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Tìm"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutGenreChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_play"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🎬 Tất cả"
                android:textColor="#000000"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="💥 Hành động"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipComedy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="😂 Hài hước"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipHorror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="👻 Kinh dị"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipRomance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="💖 Tình cảm"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipSciFi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🚀 Viễn tưởng"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipAnimation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🎨 Hoạt hình"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipThriller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🔪 Giật gân"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipDocumentary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🎥 Tài liệu"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipTopRated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_prompt"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="🏆 Điểm cao"
                android:textColor="@color/textPrimary"
                android:textSize="12.5sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvSearchLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:text="🔥 Phim thịnh hành"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Không tìm thấy phim phù hợp."
            android:textColor="@color/textMuted"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

