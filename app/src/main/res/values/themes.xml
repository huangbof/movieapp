<resources>
    <style name="Theme.Uneti" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bgRoot</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Theme cho Splash (ẩn ActionBar, nền đen) -->
    <style name="Theme.Uneti.Splash" parent="Theme.Uneti">
        <item name="android:windowBackground">@color/bgRoot</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
